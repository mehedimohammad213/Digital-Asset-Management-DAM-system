{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@marcombox/*": ["marcombox-dam/*"]
    }
  },
  "include": [
    "marcombox-dam/**/*",
    "tests/**/*",
    "playwright.config.ts",
    "marcombox.global-setup.ts"
  ]
}
