{
  "name": "marcombox-dam-automation",
  "version": "1.0.0",
  "description": "Playwright automation for MarcomBox DAM asset lifecycle tests",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:scenario1": "playwright test tests/scenario1-local-upload.spec.ts",
    "test:scenario2": "playwright test tests/scenario2-folder-upload.spec.ts",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "docker:build": "docker compose build test",
    "docker:test": "docker compose run --rm test"
  },
  "keywords": [
    "playwright",
    "e2e",
    "dam",
    "qa-automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.0",
    "eslint-plugin-playwright": "^2.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0"
  }
}
